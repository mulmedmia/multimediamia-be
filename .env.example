# ==============================================================================
# MULTIMEDIA IN ACTION 2026 - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server & Runtime Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Neon Serverless PostgreSQL)
# Example: postgresql://user:password@ep-sample-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@hostname/dbname?sslmode=require"

# JWT Authentication
JWT_SECRET="generate_a_very_long_secure_random_string_here"
JWT_EXPIRATION="1d"

# CORS Allowed Origins (Comma-separated URLs for web clients)
ALLOWED_ORIGINS="https://mia2026.com,https://www.mia2026.com"

# ImageKit Storage Configuration (Media Uploads & AVIF Transformation)
IMAGEKIT_PUBLIC_KEY="public_xxxxxxxxxxxxxxxxxx"
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxxxxxxxx"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_endpoint_id"

# Email Delivery Configuration (Dual-Provider Strategy: Resend + Brevo Failover)
# Note: Render free tier blocks outbound SMTP TCP ports (25, 465, 587).
# Emails use HTTPS REST API (Port 443) which runs without any port block.
# Combined Free Allowance: 100 emails/day (Resend) + 300 emails/day (Brevo) = 400 free emails/day.

# Primary Provider: Brevo (300 emails/day) - https://www.brevo.com
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="panitia@mia2026.com"
BREVO_SENDER_NAME="KSM Multimedia"

# Secondary / Automatic Failover Provider: Resend (100 emails/day) - https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="KSM Multimedia <onboarding@resend.dev>"

# Provider Priority: "brevo" (default) or "resend"
EMAIL_PRIMARY_PROVIDER="brevo"

# Tertiary / Local Dev Fallback: Outbound SMTP (Gmail / Custom Mail server)
EMAIL_USER="admin@mia2026.com"
EMAIL_PASSWORD="app_specific_password_or_smtp_secret"

# Safety & Dev Flags
# Set to "false" in production to prevent logging OTP to server terminal stdout
ALLOW_DEV_OTP_FALLBACK="false"

# Initial Admin Seeding (Used by npm run seed)
ADMIN_NAME="Super Administrator MIA 2026"
ADMIN_EMAIL="admin@mia2026.com"
ADMIN_PASSWORD="super_secure_admin_password"