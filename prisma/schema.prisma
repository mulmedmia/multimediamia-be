// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  users_id   String        @id @default(uuid())
  username   String
  name       String
  email      String        @unique
  password   String
  role       Role          @default(USER)
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt

  blogs        Blog[]
  competitions Competition[]
  registrations Registration[]
}

model Blog {
  id_blog     String   @id @default(uuid())
  title       String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user_id     String
  thumbnail   String
  status      BlogStatus
  category    String
  published_at DateTime?

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user User @relation(fields: [user_id], references: [users_id])
}

model Competition {
  competition_id String   @id @default(uuid())
  user_id        String
  name           String
  startDate      DateTime
  endDate        DateTime
  organizer      String
  website        String
  title          String
  description    String
  deadline       DateTime
  image          String
  status         CompetitionStatus
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user           User       @relation(fields: [user_id], references: [users_id])
  registrations  Registration[]
}

model Registration {
  registration_id String   @id @default(uuid())
  user_id         String
  competition_id  String
  file_upload     String
  note            String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user        User        @relation(fields: [user_id], references: [users_id])
  competition Competition @relation(fields: [competition_id], references: [competition_id])
}

enum Role {
  ADMIN
  USER
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CompetitionStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}
