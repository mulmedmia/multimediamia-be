// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  users_id   String   @id @default(cuid())
  name       String
  nim        String?  @unique
  email      String   @unique
  password   String
  role       Role     @default(USER)
  point      String?
  badge      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  blogs         Blog[]
  categories    Category[]
  registrations Registration[]
  peminatan     peminatan[]
  kelas        kelas[]
}

model Blog {
  id_blog      String    @id @default(cuid())
  title        String
  content      String
  user_id      String
  thumbnail    String
  category     String
  is_active    Boolean
  published_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [users_id])
}

model Category {
  category_id   String             @id @default(cuid())
  category_name String
  user_id       String
  name          String
  startDate     DateTime
  endDate       DateTime
  organizer     String
  title         String
  description   String
  deadline      DateTime
  image         String
  team_type     TeamType           @default(INDIVIDUAL) 
  status        VerificationStatus
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt

  user          User           @relation(fields: [user_id], references: [users_id])
  registrations Registration[]
}

model Registration {
  registration_id String   @id @default(cuid())
  user_id         String
  category_id     String
  file_url        String
  team_name       String? 
  team_members    String?  
  is_verified     Boolean
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user     User     @relation(fields: [user_id], references: [users_id])
  category Category @relation(fields: [category_id], references: [category_id])
}

model OTP {
  id         String   @id @default(cuid())
  email      String
  code       String
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([email])
}

model peminatan{
  peminatan_id     String @id @default(cuid())
  user_id          String
  nama_peminatan   String
  imageUrl         String  
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user          User           @relation(fields: [user_id], references: [users_id])
}

model kelas{
  kelas_id         String @id @default(cuid())
  user_id          String
  nama_kelas       String
  linkClassroom    String  
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user          User           @relation(fields: [user_id], references: [users_id])
}

enum Role {
  USER
  ADMIN
  MENTOR
}

enum VerificationStatus {
  VERIFIED
  NOT_VERIFIED
}

enum TeamType {
  INDIVIDUAL
  GROUP
}