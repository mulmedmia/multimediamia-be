generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  users_id      String         @id @default(cuid())
  name          String
  nim           String?        @unique
  email         String         @unique
  password      String
  role          Role           @default(USER)
  is_verified   Boolean        @default(false)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  points        Int            @default(0)
  categories    Category[]
  registrations Registration[]
  submissions   Submission[]
  Redemption    Redemption[]
}

model Category {
  category_id   String             @id @default(cuid())
  category_name String
  user_id       String
  name          String
  startDate     DateTime
  endDate       DateTime
  organizer     String
  title         String
  description   String
  deadline      DateTime
  image         String
  file_url      String?
  team_type     TeamType           @default(INDIVIDUAL)
  status        VerificationStatus
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt

  user          User           @relation(fields: [user_id], references: [users_id])
  registrations Registration[]
  submissions   Submission[]
}

model Registration {
  registration_id String   @id @default(cuid())
  user_id         String
  category_id     String
  file_url        String
  team_name       String?
  team_members    String?
  is_verified     Boolean
  feedback         String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user     User     @relation(fields: [user_id], references: [users_id])
  category Category @relation(fields: [category_id], references: [category_id])
}

model Submission {
  submission_id    String           @id @default(cuid())
  user_id          String
  category_id      String
  team_name        String
  project_name     String
  description      String
  flow_application String
  score            Float?
  feedback         String?
  status           SubmissionStatus @default(PENDING)
  is_verified      Boolean          @default(false)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  user     User             @relation(fields: [user_id], references: [users_id])
  category Category         @relation(fields: [category_id], references: [category_id])
  links    SubmissionLink[]
}

model SubmissionLink {
  link_id       String   @id @default(cuid())
  submission_id String
  link_type     LinkType
  url           String
  description   String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  submission Submission @relation(fields: [submission_id], references: [submission_id], onDelete: Cascade)
}

model OTP {
  id         String   @id @default(cuid())
  email      String
  code       String
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([email])
}

model product {
  product_id  String       @id @default(cuid())
  name        String
  description String
  price       Float
  image_url   String
  stock       Int          @default(0)
  is_active   Boolean      @default(true)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  Redemption  Redemption[]
}

model Redemption {
  redemption_id String   @id @default(cuid())
  user_id       String
  product_id    String
  points_used   Int
  created_at    DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [users_id])
  product product @relation(fields: [product_id], references: [product_id])
}

enum Role {
  USER
  ADMIN
  JURI
}

enum VerificationStatus {
  VERIFIED
  NOT_VERIFIED
}

enum TeamType {
  INDIVIDUAL
  GROUP
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION
}

enum LinkType {
  GITHUB
  YOUTUBE
  OTHER
}
